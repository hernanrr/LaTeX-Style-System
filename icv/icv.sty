% icv/icv.sty
% Sistema de estilo para materiales de clase -- Escuela de Ingeniería Civil y
% Ambiental, PUCMM. Ver STYLE.md para las reglas completas y docs/packages.md
% para la justificación de cada paquete cargado aquí.
%
% Requiere LuaLaTeX + latexmk (nunca pdflatex/xelatex).
%
% IMPORTANTE -- PDF etiquetado: cada documento que use este paquete debe
% empezar con \DocumentMetadata{...} como primerísima línea, ANTES de
% \documentclass. Esto no puede vivir dentro de un \usepackage, así que se
% define en cada plantilla (templates/*/*.tex), no aquí.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icv}[2026/08/31 v0.1 Sistema de estilo ICV -- PUCMM]

% ---------------------------------------------------------------------------
% 1. Motor obligatorio: LuaLaTeX
% ---------------------------------------------------------------------------
\RequirePackage{iftex}
\ifLuaTeX\else
  \PackageError{icv}%
    {Este documento requiere LuaLaTeX}%
    {Compila con `latexmk -lualatex`. Nunca uses pdflatex ni xelatex.}
\fi

% ---------------------------------------------------------------------------
% 2. Opciones del paquete
% ---------------------------------------------------------------------------
% \usepackage[biblatex]{icv} activa citas (biblatex+biber, APA 7, español).
% Opt-in por documento -- no todos los tipos de documento citan.
\newif\ificv@biblatex
\DeclareOption{biblatex}{\icv@biblatextrue}
\ProcessOptions\relax

% ---------------------------------------------------------------------------
% 3. Paquetes núcleo
% ---------------------------------------------------------------------------
\RequirePackage{fontspec}
\RequirePackage[spanish,es-noshorthands]{babel}
\RequirePackage{geometry}
\RequirePackage[expansion=false]{microtype}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
% unicode-math se carga DESPUÉS de amsmath/amssymb -- si va antes, choca con
% amssymb (p.ej. "Command \eth already defined") porque ambos declaran los
% mismos símbolos matemáticos.
\RequirePackage{unicode-math}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage[dvipsnames,table]{xcolor}
\RequirePackage[breakable]{tcolorbox}
\RequirePackage{caption}
\RequirePackage{longtable}
\RequirePackage{makecell}
\RequirePackage{graphicx}
\RequirePackage{siunitx}
\RequirePackage{hyperref}
\RequirePackage{pgfkeys}
\RequirePackage{etoolbox} % \ifdefempty -- comprobar si un campo/macro opcional quedó vacío
\RequirePackage{xkeyval}  % \define@key/\setkeys -- opción points= de icvproblem

\ificv@biblatex
  \RequirePackage{csquotes}
  \RequirePackage[backend=biber,style=apa,sorting=nyt,language=spanish]{biblatex}
  \DeclareLanguageMapping{spanish}{spanish-apa}
\fi

% ---------------------------------------------------------------------------
% 4. Tokens de color
% ---------------------------------------------------------------------------
\input{tokens}

% ---------------------------------------------------------------------------
% 5. Tipografía
% ---------------------------------------------------------------------------
\setmainfont{TeX Gyre Pagella}
\setsansfont{TeX Gyre Heros}
\setmathfont{TeX Gyre Pagella Math}
\color{icvblack}

% ---------------------------------------------------------------------------
% 5.5. Detección de clase KOMA vs. no-KOMA
% ---------------------------------------------------------------------------
% icv.sty se carga bajo scrartcl (KOMA) para la mayoría de tipos de
% documento, pero también bajo la clase `exam` (no-KOMA) para exámenes que
% necesitan puntaje automático -- ver STYLE.md § Arquitectura. KOMAClassName
% solo existe si la clase base es de la familia KOMA-Script.
\newif\ificv@koma
\@ifundefined{KOMAClassName}{\icv@komafalse}{\icv@komatrue}

% ---------------------------------------------------------------------------
% 6. Geometría y espaciado numérico (siunitx v3)
% ---------------------------------------------------------------------------
\geometry{letterpaper,margin=2.5cm,bottom=2.8cm}

% Espaciado de párrafos: opción nativa de KOMA si aplica, o el paquete
% parskip si no (bajo una clase no-KOMA no hay warning que evitar).
\ificv@koma
  \KOMAoptions{parskip=half}
\else
  \RequirePackage{parskip}
\fi

\sisetup{
  output-decimal-marker = {.},
  group-separator       = {,},
  group-minimum-digits  = 4,
  per-mode              = symbol,
}

% ---------------------------------------------------------------------------
% 7. Logo institucional (config local por máquina, gitignored)
% ---------------------------------------------------------------------------
% icv-local.cfg.tex define \icvlogopath{<ruta absoluta a logo_pucmm_lineas-Negras.png>}.
% No existe en el repo -- ver icv/icv-local.cfg.tex.example. Sin config local,
% \icvmaketitle simplemente omite el logo (no falla la compilación).
\newcommand{\icvlogopath}{}
\IfFileExists{icv-local.cfg.tex}{\input{icv-local.cfg.tex}}{}

% ---------------------------------------------------------------------------
% 8. Metadata del documento: \icvsetup
% ---------------------------------------------------------------------------
% Valores por defecto -- se definen ANTES de instalar los manejadores de
% pgfkeys para no depender de la semántica exacta de `.initial` con `.store in`.
\newcommand{\icv@asignatura}{}
\newcommand{\icv@titulocorto}{}
\newcommand{\icv@profesor}{Dr. Ricardo Hernández Moreira}
\newcommand{\icv@periodo}{}
\newcommand{\icv@version}{v1}
\newcommand{\icv@titulo}{}
\newcommand{\icv@subtitulo}{}

\pgfkeys{
  /icv/.cd,
  asignatura/.store in  = \icv@asignatura,
  titulocorto/.store in = \icv@titulocorto,
  profesor/.store in    = \icv@profesor,
  periodo/.store in     = \icv@periodo,
  version/.store in     = \icv@version,
  titulo/.store in      = \icv@titulo,
  subtitulo/.store in   = \icv@subtitulo,
}
\newcommand{\icvsetup}[1]{\pgfkeys{/icv/.cd,#1}}

% Metadata PDF automática a partir de \icvsetup -- evita la duplicación
% manual de título/autor/asunto que causaba PDFs sin metadata en legacy/
% (ver hallazgo "A-Proy no emite metadata PDF" del inventario de Fase 1).
% Se lee al final del preámbulo, cuando \icvsetup ya se ejecutó.
\AtBeginDocument{%
  \hypersetup{
    pdftitle  = \icv@titulo,
    pdfauthor = \icv@profesor,
    pdfsubject= \icv@asignatura,
  }%
}

% ---------------------------------------------------------------------------
% 9. Encabezado / pie de página
% ---------------------------------------------------------------------------
% KOMA: scrlayer-scrpage nativo. Clase `exam`: su propio sistema de
% encabezado/pie (\firstpageheader/\runningheader) -- forzar fancyhdr ahí
% choca porque exam.cls ya define \lhead y equivalentes por su cuenta.
% Cualquier otra clase no-KOMA: fancyhdr genérico.
\ificv@koma
  \RequirePackage[automark]{scrlayer-scrpage}
  \pagestyle{scrheadings}
  \clearpairofpagestyles
  \KOMAoptions{headsepline=0.4pt}
  \setkomafont{pageheadfoot}{\normalfont\small\color{icvgray-text}}
  \ihead{\ifdefempty{\icv@titulocorto}{\icv@asignatura}{\icv@titulocorto}}
  \ohead{\thepage}
\else
  \@ifclassloaded{exam}{%
    \pagestyle{headandfoot}
    \firstpageheader%
      {\small\color{icvgray-text}\ifdefempty{\icv@titulocorto}{\icv@asignatura}{\icv@titulocorto}}%
      {}%
      {\small\color{icvgray-text}\thepage}
    \runningheader%
      {\small\color{icvgray-text}\ifdefempty{\icv@titulocorto}{\icv@asignatura}{\icv@titulocorto}}%
      {}%
      {\small\color{icvgray-text}\thepage}
    \runningheadrule
  }{%
    \RequirePackage{fancyhdr}
    \pagestyle{fancy}
    \fancyhf{}
    \renewcommand{\headrulewidth}{0.4pt}
    \fancyhead[L]{\small\color{icvgray-text}%
      \ifdefempty{\icv@titulocorto}{\icv@asignatura}{\icv@titulocorto}}
    \fancyhead[R]{\small\color{icvgray-text}\thepage}
  }%
\fi

% ---------------------------------------------------------------------------
% 10. Jerarquía tipográfica de secciones
% ---------------------------------------------------------------------------
% KOMA: disposition ya es sans-serif por defecto (\setsansfont fija TeX
% Gyre Heros), solo hace falta el color. No-KOMA: titlesec hace ambas cosas.
\ificv@koma
  \addtokomafont{section}{\color{icvblue}}
  \addtokomafont{subsection}{\color{icvblue}}
  \addtokomafont{subsubsection}{\color{icvblue}}
\else
  \RequirePackage{titlesec}
  % El punto tras el número replica el estilo por defecto de KOMA, para que
  % ambas ramas (KOMA / no-KOMA) se vean iguales.
  \titleformat{\section}{\sffamily\Large\bfseries\color{icvblue}}{\thesection.}{0.5em}{}
  \titleformat{\subsection}{\sffamily\large\bfseries\color{icvblue}}{\thesubsection.}{0.5em}{}
  \titleformat{\subsubsection}{\sffamily\normalsize\bfseries\color{icvblue}}{\thesubsubsection.}{0.5em}{}
\fi

% ---------------------------------------------------------------------------
% 11. Bloque de título: \icvmaketitle
% ---------------------------------------------------------------------------
\newcommand{\icvmaketitle}{%
  \begingroup
  \begin{center}
    \ifdefempty{\icvlogopath}{}{%
      \includegraphics[height=1.4cm,alt={Logo institucional PUCMM}]{\icvlogopath}\\[6pt]%
    }
    {\sffamily\small\color{icvgray-text}%
      Pontificia Universidad Católica Madre y Maestra\\
      Escuela de Ingeniería Civil y Ambiental}\\[6pt]
    {\color{icvblue}\rule{\linewidth}{2pt}}\\[6pt]
    {\sffamily\Large\bfseries\color{icvblue}\icv@asignatura}\\[2pt]
    {\sffamily\LARGE\bfseries\color{icvblue}\icv@titulo}\\
    \ifdefempty{\icv@subtitulo}{}{%
      {\small\itshape\color{icvgray-text}\icv@subtitulo}\\%
    }
    {\color{icvblue}\rule{\linewidth}{2pt}}\\[6pt]
  \end{center}
  \begin{center}
  \begin{tabular}{ll}
    \toprule
    \textbf{Profesor:} & \icv@profesor \\
    \textbf{Período académico:} & \icv@periodo \\
    \textbf{Versión:} & \icv@version \\
    \bottomrule
  \end{tabular}
  \end{center}
  \vspace{6pt}
  \endgroup
}

% ---------------------------------------------------------------------------
% 12. Figuras con texto alternativo obligatorio
% ---------------------------------------------------------------------------
% \icvincludegraphics[opciones,alt={texto alternativo}]{ruta}
% "alt" es una opción más (igual que width=, height=...) que graphicx/hyperref
% ya entienden de forma nativa bajo PDF etiquetado -- aquí solo se valida que
% esté presente ANTES de dibujar la figura, con un error explícito si falta.
\define@key{icvimgcheck}{alt}{\def\icv@img@alt{#1}}
\newcommand{\icvincludegraphics}[2][]{%
  \def\icv@img@alt{ICV-ALT-NO-DECLARADO}%
  \setkeys*{icvimgcheck}{#1}%
  \ifdefstring{\icv@img@alt}{ICV-ALT-NO-DECLARADO}{%
    \PackageError{icv}%
      {Falta texto alternativo (alt=) en \string\icvincludegraphics}%
      {Toda figura requiere alt= para PDF etiquetado, p.ej.:\MessageBreak
       \string\icvincludegraphics[width=4cm,alt={Descripción...}]{ruta}}%
  }{}%
  \includegraphics[#1]{#2}%
}

% ---------------------------------------------------------------------------
% 13. Objetivos de aprendizaje
% ---------------------------------------------------------------------------
% \begin{icvobjectives}
%   \item Primer objetivo
%   \item Segundo objetivo
% \end{icvobjectives}
\newenvironment{icvobjectives}{%
  \begin{tcolorbox}[%
    colback=icvcyan-bg, colframe=icvcyan, breakable,
    fonttitle=\bfseries\color{white}, colbacktitle=icvcyan,
    title={Objetivos de aprendizaje}%
  ]%
  \begin{itemize}
}{%
  \end{itemize}
  \end{tcolorbox}%
}

% ---------------------------------------------------------------------------
% 14. Cajas semánticas genéricas: nota y advertencia
% ---------------------------------------------------------------------------
% Reemplazan la familia dispersa de legacy/ (\handoutintro, \excelnote,
% \weightednote, \resultbox...) -- incluso ahí \resultbox ya era, en la
% práctica, una \warnbox con otra etiqueta (ver inventario de Fase 1). Un
% título libre cubre todos esos casos sin multiplicar nombres de macro.
%
% \begin{icvnote}[Propósito]      ... \end{icvnote}   -- azul institucional
% \begin{icvwarning}[Resultado clave] ... \end{icvwarning} -- amarillo institucional
\newenvironment{icvnote}[1][Nota]{%
  \begin{tcolorbox}[%
    colback=icvblue-bg, colframe=icvblue, breakable,
    fonttitle=\bfseries\color{white}, colbacktitle=icvblue,
    title={#1}%
  ]%
}{%
  \end{tcolorbox}%
}

\newenvironment{icvwarning}[1][Atención]{%
  \begin{tcolorbox}[%
    colback=icvyellow-bg, colframe=icvyellow!60!icvblack, breakable,
    fonttitle=\bfseries\color{icvblack}, colbacktitle=icvyellow,
    title={#1}%
  ]%
}{%
  \end{tcolorbox}%
}

% ---------------------------------------------------------------------------
% 15. Problemas (asignaciones/exámenes tipo article) con puntaje opcional
% ---------------------------------------------------------------------------
% \begin{icvproblem}[points=10]{Título del problema}
%   ...
% \end{icvproblem}
\newcounter{icvproblem}
\define@key{icvproblem}{points}{\def\icv@problempoints{#1}}
\newenvironment{icvproblem}[2][]{%
  \def\icv@problempoints{}%
  \setkeys{icvproblem}{#1}%
  \refstepcounter{icvproblem}%
  \begin{tcolorbox}[%
    colback=icvblue-bg, colframe=icvblue, breakable,
    fonttitle=\bfseries\color{white}, colbacktitle=icvblue,
    title={Problema~\theicvproblem: #2%
      \ifdefempty{\icv@problempoints}{}{\hfill(\icv@problempoints~pts)}}%
  ]%
}{%
  \end{tcolorbox}%
}

\endinput
